<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_System_Time" Id="{5538c938-e0ce-479c-836f-7e403d8ebc09}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_System_Time
VAR_OUTPUT
    Delta_Time : LREAL := 0;
	now : ULINT := 0;
END_VAR
VAR
    Last_Time : ULINT := 0;
	ConversionFactorSeconds : LREAL := 1E-7;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// FB must be called every PLC cycle, prefferably in the main() function.
// FB is used to calculate dt (change in time) from the last PLC cycle
// NOT COMPILED OR TESTED ON TARGET PLC.


now := Tc2_System.F_GetSystemTime();

IF Last_Time > 0 THEN
    Delta_Time := TO_LREAL(now - Last_Time) * ConversionFactorSeconds;
ELSE
    Delta_Time := 0;
END_IF

Last_Time := now;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>